{
  "id": "venus_a",
  "name": {
    "en": "Marstek Venus A",
    "nl": "Marstek Venus A"
  },
  "class": "battery",
  "capabilities": [
    "onoff",
    "measure_battery",
    "measure_power",
    "meter_power.charged",
    "meter_power.discharged",
    "measure_temperature",
    "measure_signal_strength",
    "operation_mode"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "On / off",
        "nl": "Aan / uit"
      }
    },
    "measure_battery": {
      "title": {
        "en": "Battery level",
        "nl": "Batterijniveau"
      }
    },
    "measure_power": {
      "title": {
        "en": "Battery power",
        "nl": "Batterijvermogen"
      }
    },
    "meter_power.charged": {
      "title": {
        "en": "Charged energy",
        "nl": "Geladen energie"
      }
    },
    "meter_power.discharged": {
      "title": {
        "en": "Discharged energy",
        "nl": "Ontladen energie"
      }
    },
    "measure_temperature": {
      "title": {
        "en": "Battery temperature",
        "nl": "Batterijtemperatuur"
      }
    },
    "measure_signal_strength": {
      "title": {
        "en": "Wi-Fi signal",
        "nl": "WiFi-signaal"
      }
    }
  },
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "images": {
    "small": "/drivers/venus_a/assets/images/small.png",
    "large": "/drivers/venus_a/assets/images/large.png",
    "xlarge": "/drivers/venus_a/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "start"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "nl": "Verbinding"
      },
      "children": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "IP address",
            "nl": "IP-adres"
          },
          "value": "",
          "hint": {
            "en": "Local IP address of the battery, e.g. 192.168.1.50",
            "nl": "Lokaal IP-adres van de batterij, bijvoorbeeld 192.168.1.50"
          }
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "UDP port",
            "nl": "UDP-poort"
          },
          "value": 30000,
          "min": 1,
          "max": 65535
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Poll interval (seconds, 0 = off)",
            "nl": "Poll-interval (seconden, 0 = uit)"
          },
          "value": 60,
          "min": 0,
          "max": 3600,
          "hint": {
            "en": "How often the battery is polled. Keep this at 60 seconds or more: the local UDP server of these batteries stops answering when polled too often. Values below 30 are raised to 30.",
            "nl": "Hoe vaak de batterij wordt uitgelezen. Houd dit op 60 seconden of meer: de lokale UDP-server van deze batterijen stopt met antwoorden bij te vaak pollen. Waarden onder 30 worden 30."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "On / off mapping",
        "nl": "Aan / uit koppeling"
      },
      "children": [
        {
          "id": "mode_on",
          "type": "dropdown",
          "label": {
            "en": "Mode when switched ON",
            "nl": "Modus bij INSCHAKELEN"
          },
          "value": "Auto",
          "values": [
            { "id": "Auto", "label": { "en": "Auto (self consumption)" } },
            { "id": "AI", "label": { "en": "AI" } },
            { "id": "UPS", "label": { "en": "UPS (backup)" } },
            { "id": "Manual", "label": { "en": "Manual (schedule / fixed power)" } },
            { "id": "Passive", "label": { "en": "Passive (external control)" } }
          ]
        },
        {
          "id": "mode_off",
          "type": "dropdown",
          "label": {
            "en": "Mode when switched OFF",
            "nl": "Modus bij UITSCHAKELEN"
          },
          "value": "Manual",
          "values": [
            { "id": "Manual", "label": { "en": "Manual (schedule disabled = battery idle)" } },
            { "id": "UPS", "label": { "en": "UPS (backup disabled)" } },
            { "id": "Passive", "label": { "en": "Passive (0 W, external control)" } },
            { "id": "Auto", "label": { "en": "Auto with auto_cfg disabled" } },
            { "id": "AI", "label": { "en": "AI with ai_cfg disabled" } }
          ],
          "hint": {
            "en": "The mode is applied with its sub-configuration switched OFF (enable = 0). Manual with no active schedule makes the battery idle.",
            "nl": "De modus wordt gezet met de sub-configuratie UIT (enable = 0). Manual zonder actief schema laat de batterij niets doen."
          }
        },
        {
          "id": "manual_power",
          "type": "number",
          "label": {
            "en": "Power used in Manual mode (W)",
            "nl": "Vermogen in Manual-modus (W)"
          },
          "value": 800,
          "min": 0,
          "max": 5000,
          "hint": {
            "en": "Used by Manual and Passive, both for on/off and for the 'Set battery mode' flow card when it has no power of its own",
            "nl": "Geldt voor Manual en Passive, zowel bij aan/uit als bij de flowkaart 'Batterijmodus instellen' zonder eigen vermogen"
          }
        },
        {
          "id": "manual_slot",
          "type": "number",
          "label": {
            "en": "Schedule slot used for Manual (0-9)",
            "nl": "Schemaslot voor Manual (0-9)"
          },
          "value": 0,
          "min": 0,
          "max": 9,
          "hint": {
            "en": "Manual mode writes this slot of the battery schedule (00:00-23:59, every day). Pick a slot you do not use in the Marstek app, otherwise that schedule entry is overwritten.",
            "nl": "De Manual-modus schrijft dit slot van het batterijschema (00:00-23:59, elke dag). Kies een slot dat je in de Marstek-app niet gebruikt, anders wordt dat schema-onderdeel overschreven."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Wi-Fi of the battery (read-only)",
        "nl": "WiFi van de batterij (alleen lezen)"
      },
      "children": [
        {
          "id": "wifi_ssid",
          "type": "label",
          "label": { "en": "Network (SSID)", "nl": "Netwerk (SSID)" },
          "value": "onbekend"
        },
        {
          "id": "wifi_rssi",
          "type": "label",
          "label": { "en": "Signal strength", "nl": "Signaalsterkte" },
          "value": "onbekend"
        },
        {
          "id": "wifi_ip",
          "type": "label",
          "label": { "en": "IP address (battery)", "nl": "IP-adres (batterij)" },
          "value": "onbekend"
        },
        {
          "id": "wifi_gateway",
          "type": "label",
          "label": { "en": "Gateway / netmask", "nl": "Gateway / subnetmasker" },
          "value": "onbekend"
        },
        {
          "id": "wifi_mac",
          "type": "label",
          "label": { "en": "Wi-Fi MAC address", "nl": "WiFi-MAC-adres" },
          "value": "onbekend"
        },
        {
          "id": "wifi_bijgewerkt",
          "type": "label",
          "label": { "en": "Last read", "nl": "Laatst uitgelezen" },
          "value": "onbekend"
        }
      ]
    }
  ]
}
